# ---------- Mode ----------
# MOCK=true makes every MCP server return fixture data (no credentials needed).
MOCK=true
# mock | openai | azure | anthropic
LLM_PROVIDER=mock
# Seconds per agent step in mock mode (demo pacing only)
MOCK_STEP_DELAY=1.2

# ---------- LLM ----------
# openai    -> OpenAI-compatible gateway (vLLM, LiteLLM, TGI, internal gateway): {LLM_BASE_URL}/chat/completions
# azure     -> Azure OpenAI: {LLM_BASE_URL}/openai/deployments/{LLM_MODEL}/chat/completions
# anthropic -> {LLM_BASE_URL}/v1/messages
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AZURE_API_VERSION=2024-10-21
LLM_TIMEOUT=90
LLM_MAX_TOKENS=2000

# ---------- Agent ----------
AGENT_MAX_STEPS=10
TOOL_RESULT_MAX_CHARS=6000
# Write actions from the UI (work note, rollback MR). Off by default.
ENABLE_ACTIONS=false
# Reject requests without an identity header (set true behind oauth2-proxy / SSO).
REQUIRE_USER_HEADER=false
# ServiceNow webhook auto-triage (empty = webhook disabled; set a long random value to enable)
WEBHOOK_SECRET=
AUTO_TRIAGE_PRIORITIES=1,2

# ---------- ServiceNow ----------
SNOW_URL=https://yourinstance.service-now.com
SNOW_TOKEN=
SNOW_USER=
SNOW_PASSWORD=

# ---------- Datadog ----------
DD_SITE=datadoghq.com
DD_API_KEY=
DD_APP_KEY=

# ---------- Elastic / Kibana ----------
ES_URL=https://elastic.internal:9200
ES_API_KEY=
ES_USER=
ES_PASSWORD=
KIBANA_URL=https://kibana.internal
ES_LEVEL_FIELD=log.level
ES_ERROR_TYPE_FIELD=error.type
ES_MESSAGE_FIELD=message

# ---------- GitLab ----------
GITLAB_URL=https://gitlab.internal
GITLAB_TOKEN=

# ---------- TLS ----------
# Path to a corporate CA bundle, if your internal endpoints use a private CA.
CA_BUNDLE=
